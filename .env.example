# Dynamic WebMCP Agent Network - Environment Configuration
# Copy this file to .env and customize as needed. Never commit actual secret keys.

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=false

# Fetch.ai / Agentverse Integration
USE_AGENTVERSE=false
AGENTVERSE_API_KEY=your_agentverse_api_key_here
AGENTVERSE_MAILBOX_URL=https://agentverse.ai/v1/mailbox
DISPATCHER_SEED=dynamic-webmcp-dispatcher-seed-2026-v1

# Security & Policies
APPROVAL_TTL_SECONDS=300
PRICE_DRIFT_TOLERANCE_PERCENT=0.0
REQUIRE_APPROVAL_FOR_CART=true
REQUIRE_APPROVAL_FOR_CHECKOUT=true

# Execution Modes
WEBMCP_EXECUTION_MODE=webmcp_browser
ENABLE_PARALLEL_SEARCH=true
