# Dynamic WebMCP Agent Network — Environment Configuration Template
# Copy this file to .env and configure your local keys. NEVER commit actual seeds or keys to Git.

# Fetch.ai & ASI:One Integration
# Generate a fresh 32+ char seed using: python scripts/gen_seed.py
AGENT_SEED_PHRASE=
AGENT_NAME=dynamic_webmcp_operator
AGENT_PORT=8001
AGENTVERSE_API_KEY=
AGENTVERSE_MAILBOX_URL=https://agentverse.ai/v1/mailbox

# ASI1 LLM API (OpenAI-compatible endpoint at https://api.asi1.ai/v1)
# Obtain from your ASI:One developer settings
ASI1_API_KEY=

# Execution & Policy Controls
# Mode: "headless" (standard for ASI:One chat) or "webmcp_browser" (companion demo store)
WEBMCP_EXECUTION_MODE=headless
APPROVAL_TTL_SECONDS=300
PRICE_DRIFT_TOLERANCE_PERCENT=0.0
